# ========================================================
# Attendance Portal - Environment Configuration
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Browser safe)
# --------------------------------------------------------
# These variables are bundled into the client application.
# NEVER include service role keys or administrative secrets here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# --------------------------------------------------------
# 2. SERVER-SIDE & EDGE FUNCTION SECRETS (DO NOT EXPOSE)
# --------------------------------------------------------
# Used ONLY in Supabase Edge Functions, Node scripts, or CI/CD.
# NEVER prefix these with VITE_ and NEVER commit actual keys to Git.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key
ADMIN_BOOTSTRAP_SECRET=your-one-time-admin-bootstrap-setup-secret

# --------------------------------------------------------
# 3. CLI BOOTSTRAP CREDENTIALS (FOR INITIAL ADMIN SETUP ONLY)
# --------------------------------------------------------
ADMIN_USERNAME=sysadmin
ADMIN_PASSWORD=your-strong-temporary-admin-password
ADMIN_FULL_NAME="System Administrator"
